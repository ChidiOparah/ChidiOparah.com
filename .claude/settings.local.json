{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__ec42b351-dbea-47c8-8126-12276171e7a4__get_posts",
      "mcp__ec42b351-dbea-47c8-8126-12276171e7a4__get_profile_history"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q 'Self-update instructions' '.claude/commands/website.md' && echo 'skill ok' || echo 'WARNING: /website skill missing self-update section'"
          }
        ]
      }
    ]
  }
}
