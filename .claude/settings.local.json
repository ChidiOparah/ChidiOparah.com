{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "grep -q 'Self-update instructions' '.claude/commands/website.md' && echo 'skill ok' || echo 'WARNING: /website skill missing self-update section'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git init *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git reset *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(ssh-add -l)",
      "Bash(ssh-keygen *)",
      "Bash(ssh-keyscan github.com)",
      "Bash(ssh -T git@github.com)",
      "Bash(aws sts *)",
      "Bash(aws route53 *)",
      "Bash(dig chidioparah.com A +short)",
      "Bash(dig www.chidioparah.com CNAME +short)",
      "Bash(curl -sI https://chidioparah.com)",
      "WebFetch(domain:rvelate.com)"
    ]
  }
}
